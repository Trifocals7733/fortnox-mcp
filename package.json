{
  "name": "fortnox-mcp",
  "version": "1.0.1",
  "description": "MCP server for Fortnox Swedish accounting API integration",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "fortnox-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "get-token": "tsx --env-file-if-exists=.env scripts/get-token.ts",
    "snapshot:tools": "tsx scripts/snapshot-tools.ts",
    "check:tools": "tsx scripts/snapshot-tools.ts --check",
    "build": "tsc",
    "clean": "rm -rf dist",
    "smoke": "tsx --env-file-if-exists=.env scripts/smoke.ts",
    "company": "tsx scripts/company.ts",
    "lint": "biome check src scripts",
    "format": "biome check --write src scripts",
    "format:check": "biome format src scripts",
    "check": "npm run build && npm run lint && npm run check:tools"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trifocals7733/fortnox-mcp.git"
  },
  "homepage": "https://github.com/Trifocals7733/fortnox-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@modelcontextprotocol/server-legacy": "^2.4.0",
    "effect": "^4.0.6",
    "express": "^4.21.0",
    "jose": "^5.9.6"
  },
  "optionalDependencies": {
    "@upstash/redis": "^1.34.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "mcp",
    "fortnox",
    "accounting",
    "api",
    "sweden"
  ]
}
