# Copy to .env — loaded automatically by npm start / dev / get-token
# (Node's --env-file-if-exists, no dotenv dependency).

# From the Fortnox developer portal: https://developer.fortnox.se
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=

# Obtain with: npm run get-token
# Refresh tokens are single-use; the latest one is also kept in
# ~/.fortnox-mcp/tokens.json, which takes precedence over this value.
FORTNOX_REFRESH_TOKEN=

# Optional
# FORTNOX_ACCESS_TOKEN=
# FORTNOX_SCOPE=
# TRANSPORT=stdio   # or 'http'
# PORT=3000         # when TRANSPORT=http

# Only for `npm run test:live`, which writes to Fortnox. The suite refuses to
# run unless the connected company's database number matches this value.
# FORTNOX_TEST_COMPANY=1888108
